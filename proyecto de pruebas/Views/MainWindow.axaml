<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:proyecto_de_pruebas.ViewModels"
        xmlns:models="using:proyecto_de_pruebas.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="proyecto_de_pruebas.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="proyecto de pruebas"
        Background="{Binding colorFondo}">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <Button Content="{Binding azul}" Click="Button_Click_azul"/>
        <Button Content="{Binding rojo}" Click="Button_Click_rojo"/>
       
        <ListBox ItemsSource="{Binding Personas}">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:Persona">
                    <StackPanel>
                        <TextBlock Text="{Binding Nombre}" />
                        <TextBlock Text="{Binding Edad}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>
